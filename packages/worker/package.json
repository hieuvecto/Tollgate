{
  "name": "@tollgate/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS=--conditions=source tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
