# Require fresh user approval for every push from this repository.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Always ask the user for explicit permission immediately before running git push.",
    match = [
        "git push",
        "git push origin main",
        "git push --force-with-lease origin feature/example",
    ],
    not_match = [
        "git status",
        "git pull",
    ],
)
