{
  "title": "Tollgate Operations",
  "uid": "tollgate",
  "schemaVersion": 41,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "targets": [{ "expr": "sum(rate(tollgate_requests_total[1m])) by (model,status)" }],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "TTFT p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(tollgate_ttft_seconds_bucket[5m])) by (le,model))"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox lag",
      "targets": [{ "expr": "tollgate_outbox_lag_seconds" }],
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 5 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reservation leaks",
      "targets": [{ "expr": "tollgate_reservation_leaks" }],
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 5 }
    }
  ]
}
